# Pick ONE model provider.

# Gemini free tier (key from https://aistudio.google.com/apikey). Default model: gemini-3.8-flash
GEMINI_API_KEY=

# Or any OpenAI-compatible API, e.g. Groq with an open-weights model:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# MODEL=llama-3.3-70b-versatile

# Or Claude:
# ANTHROPIC_API_KEY=

# Optional
# AGENT_PROVIDER=gemini            # gemini | openai_compatible | anthropic (inferred from the key if unset)
# MODEL=                           # override the provider's default model
# CATALOGUE_PATH=./my-catalogue.json
